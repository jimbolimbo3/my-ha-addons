{
    "name": "Matter Hub (jimbolimbo3's Fork)",
    "version": "0.0.1",
    "slug": "matter_hub_jimbolimbo3",
    "description": "My fork of the Matter Hub",
    "url": "https://github.com/jimbolimbo3/home-assistant-matter-hub",
    "arch": [
        "aarch64",
        "amd64",
        "armv7"
    ],
    "image": "ghcr.io/jimbolimbo3/home-assistant-matter-hub",
    "startup": "application",
    "boot": "auto",
    "host_network": true,
    "map": [
        "config:rw"
    ],
    "options": {
        "log_level": "info"
    },
    "schema": {
        "log_level": "list(trace|debug|info|warning|error|fatal)?"
    },
    "ports": {
        "5580/tcp": 5580
    },
    "ports_description": {
        "5580/tcp": "Matter controller port"
    },
    "webui": "http://[HOST]:[PORT:5580]",
    "ingress": true,
    "ingress_port": 5580,
    "ingress_entry": "/",
    "panel_icon": "mdi:home-automation",
    "panel_title": "Matter Hub"
}